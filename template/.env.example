# Every environment variable the app uses. Names only, never values.
# Copy to .env.local on your PC and fill in DEVELOPMENT values. .env.local is never committed.
# The cloud environment, Vercel Preview and Vercel Production set the same names with their own values.
# Where each one goes: web-dev-course/stack.md, section 3.

# Neon pooled connection string (host contains -pooler). The running app uses this.
DATABASE_URL=

# Neon direct connection string (no -pooler). drizzle-kit migrations use this.
DATABASE_URL_UNPOOLED=

# 32+ random characters, different in every environment: openssl rand -base64 32
BETTER_AUTH_SECRET=

# This environment's own base URL, e.g. http://localhost:3000
BETTER_AUTH_URL=

# From the GitHub OAuth app for this environment ("local" or "prod").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional locally. From the Sentry project settings.
SENTRY_DSN=
